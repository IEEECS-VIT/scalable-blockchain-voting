# Polygon Amoy (chain ID 80002, gas token POL)
AMOY_RPC_URL=https://polygon-amoy.drpc.org

# Testnet-only deployer key. Never commit a funded production key.
DEPLOYER_PRIVATE_KEY=

# Optional registration relayer. Use a dedicated testnet key with limited POL.
# RELAYER_RPC_URL defaults to AMOY_RPC_URL if omitted.
RELAYER_RPC_URL=
RELAYER_PRIVATE_KEY=

# ERC-4337 bundler endpoint for a sponsored Amoy UserOperation. The input
# UserOperation must already contain provider-issued paymaster data.
BUNDLER_RPC_URL=

# Optional IPFS HTTP API for vote-package upload script.
# For a local IPFS daemon, this is usually http://127.0.0.1:5001.
IPFS_API_URL=http://127.0.0.1:5001

# Optional auth header for hosted IPFS APIs. Keep real tokens in .env only.
# Example format: Bearer <token>
IPFS_API_AUTH_HEADER=
