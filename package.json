{
  "name": "scalable-blockchain-voting",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-cost testnet demonstration of a scalable privacy-preserving voting pipeline.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test:crypto": "node --test --import tsx test/BallotEncryption.ts test/CryptoBatching.ts test/IpfsUploadScript.ts test/BatchManifestScript.ts test/DataAvailabilityScript.ts test/TallyAggregationScript.ts test/DemoReadinessScript.ts test/RegistrationRelayerRequestScript.ts test/DemoFixtureScript.ts",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "upload:vote-package": "tsx scripts/upload_vote_package.ts",
    "build:registration-request": "tsx scripts/build_registration_request.ts",
    "submit:registration-relayer": "tsx scripts/submit_registration_relayer.ts",
    "demo:fixture": "tsx scripts/generate_demo_fixture.ts",
    "build:batch": "tsx scripts/build_batch_manifest.ts",
    "check:data": "tsx scripts/check_data_availability.ts",
    "check:readiness": "tsx scripts/check_demo_readiness.ts",
    "build:tally": "tsx scripts/build_tally_input.ts",
    "build:tally-result": "tsx scripts/build_tally_result.ts",
    "deploy:local": "hardhat ignition deploy ignition/modules/VotingSystem.ts",
    "deploy:amoy": "hardhat ignition deploy ignition/modules/VotingSystem.ts --network amoy"
  },
  "devDependencies": {
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.7.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.7",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "^22.20.0",
    "hardhat": "^3.9.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "viem": "^2.53.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
